<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Label: unique identifier for this launchd job.
       Used by launchctl to load, unload, start, and stop the service. -->
  <key>Label</key>
  <string>com.memory.ingest</string>

  <!-- ProgramArguments: the command to run.
       __INSTALL_DIR__ is substituted by install.sh with the real project directory. -->
  <key>ProgramArguments</key>
  <array>
    <!-- Use the absolute python3 path so launchd's minimal PATH (/usr/bin:/bin)
         does not accidentally resolve to the system Python 3.9 instead of the
         user-installed Python 3.13.  install.sh detects and writes this path. -->
    <string>__PYTHON3__</string>
    <string>__INSTALL_DIR__/memory/ingest_server.py</string>
  </array>

  <!-- RunAtLoad: start the server immediately when the plist is loaded,
       and again on every login after that. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- KeepAlive: restart automatically if the process exits unexpectedly. -->
  <key>KeepAlive</key>
  <true/>

  <!-- StandardOutPath / StandardErrorPath: both go to ingest.log for easy tailing. -->
  <key>StandardOutPath</key>
  <string>__HOME__/.memory/ingest.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.memory/ingest.log</string>
</dict>
</plist>
